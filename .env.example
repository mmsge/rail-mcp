# European Rail MCP Server - Environment Variables
# Germany (db.transport.rest) and UK (Huxley2) work without any API keys.
# Norway (Entur) only requires the header - no key needed.
# Denmark (Rejseplanen) works without an API key.
# The keys below unlock Sweden, France, and Switzerland.

# Sweden - get free key at https://www.trafiklab.se/api/trafiklab-apis/resrobot-v21/
TRAFIKLAB_API_KEY=

# France - get free key at https://numerique.sncf.com/startup/api/
SNCF_API_KEY=

# Switzerland - get free key at https://opentransportdata.swiss/en/register/
SWISS_API_KEY=
